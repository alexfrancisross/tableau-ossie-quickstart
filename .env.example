# Copy to .env and fill in. .env is gitignored; never commit real values.
# Snowflake needs nothing here: helpers/connect.py uses the [default] entry of ~/.snowflake/connections.toml
# (credentials, account, warehouse). Its user must hold OSSIE_QS_ROLE: run sql/setup_snowflake.sql once
# as ACCOUNTADMIN (the notebook switches to that role itself).
# DBT_CLOUD_* are read from .env by helpers/dbt_sl.py and PBI_* by helpers/pbi_directlake.py.

# --- dbt Cloud Semantic Layer (notebook section 7, optional) ---
# Starter+ account. Project ossie-qs must be git-connected with subdirectory
# dbt_tpch, a deployment environment, SL credentials, and a job that
# runs `dbt run --select stg_* metricflow_time_spine` then `dbt parse`.
# Some plans allow only one active project; then point that project at this
# subdirectory (or set DBT_CLOUD_PROJECT to it). Token needs job run +
# Semantic Layer. Values are never printed.
DBT_CLOUD_URL=
DBT_CLOUD_TOKEN=
DBT_CLOUD_PROJECT=ossie-qs
DBT_CLOUD_SNOWFLAKE_USER=DBT_CLOUD_SVC
DBT_CLOUD_SNOWFLAKE_ROLE=DBT_ROLE
# Optional overrides if the project has more than one env or job.
# DBT_CLOUD_ENVIRONMENT_ID=
# DBT_CLOUD_JOB_ID=

# --- Power BI / Fabric Direct Lake (notebook section 7, optional) ---
# Service principal needs Fabric Lakehouse.ReadWrite.All / workspace contributor.
# Optional: Snowflake user and role used by dbt Cloud. sql/setup_snowflake.sql grants this role CREATE on OSSIE_QS_DBT; the notebook only checks it.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
# Set to 1 only if you accept deleting the existing lakehouse tables or semantic model
# when a reload or redeploy needs it.
# PBI_ALLOW_DELETE=1
# Optional: export one L_SHIPDATE month instead of full SF1 (e.g. 1998-12).
# OSSIE_QS_TPCH_FILTER=1998-12
# Optional: LINEITEM fetch size (default 1000000).
# OSSIE_QS_CHUNK_ROWS=1000000